{
  "name": "opengym",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "api",
    "mcp"
  ],
  "scripts": {
    "test": "bun test",
    "test:all": "bun test && bun run --filter opengym-frontend test && bun run --filter gym-api test && bun run --filter opengym-mcp test",
    "build": "bun run --filter opengym-frontend build",
    "dev": "bun run --filter opengym-frontend dev",
    "start:api": "bun run --filter gym-api start"
  },
  "dependencies": {
    "dexie": "^4.0.11"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.11.2",
    "js-yaml": "^4.1.0"
  }
}
